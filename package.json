{
  "name": "twitchgate",
  "version": "2.0.0",
  "repository": "github:Akhawais/TwitchGate",
  "description": "A REST and chat proxy that centrally manages and refreshes Twitch tokens for your apps.",
  "main": "index.js",
  "scripts": {
    "init": "$(cp -n config/config.example.json config/config.json | true) && node setup.js",
    "start": "node index.js",
    "test": "yarn run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "setup": "node setup.js"
  },
  "author": "Dylan Akhawais <dylan@akhawais.co.uk>",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "basic-auth": "^2.0.1",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.1",
    "express-ws": "^4.0.0",
    "nocache": "^2.0.0",
    "ws": "^7.0.0"
  },
  "devDependencies": {
    "eslint": "^4.19.1",
    "eslint-config-airbnb-base": "^13.1.0",
    "eslint-plugin-import": "^2.11.0",
    "eslint-plugin-node": "^6.0.1",
    "eslint-plugin-promise": "^3.7.0",
    "eslint-plugin-standard": "^3.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "engines": {
    "node": ">=22"
  }
}
