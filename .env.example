TWITCHGATE_CLIENT_ID=
TWITCHGATE_CLIENT_SECRET=
# Must match a redirect URL registered on your Twitch app
TWITCHGATE_REDIRECT_URI=http://localhost:2571/gate/auth/return
# Optional: long random string required as ?state= on /gate/auth
TWITCHGATE_STATE_CODE=
# Comma-separated name:key pairs, one per service
TWITCHGATE_API_KEYS=chatbot:change-me,overlay:change-me-too
